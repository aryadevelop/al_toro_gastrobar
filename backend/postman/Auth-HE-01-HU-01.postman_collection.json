                  "});",
                  "pm.test('Mensaje de credenciales incorrectas', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.code).to.eql('AUTH-001');",
                  "  pm.expect(body.message).to.eql('Credenciales incorrectas por favor veirfique su correo y/o contraseña');",
                  "});"
