						{
							"name": "Con emailCliente – Historial de reservas del cliente (200 OK)",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"pm.test('Status 200', () => pm.response.to.have.status(200));",
											"pm.test('success = true', () => pm.expect(pm.response.json().success).to.be.true);",
											"const lista = pm.response.json().data;",
											"pm.test('data es array', () => pm.expect(lista).to.be.an('array'));",
											"if (lista.length > 0) {",
											"  const r = lista[0];",
											"  pm.test('reserva tiene campos esperados', () => {",
											"    pm.expect(r).to.include.keys(['reservaId','fechaHoraLlegada','numeroPersonas','estado','tipo']);",
											"  });",
											"  pm.test('orden descendente (primera = más reciente)', () => {",
											"    if (lista.length > 1) {",
											"      pm.expect(new Date(lista[0].fechaHoraLlegada) >= new Date(lista[1].fechaHoraLlegada)).to.be.true;",
											"    }",
											"  });",
											"}"
										],
										"type": "text/javascript"
									}
								}
							],
