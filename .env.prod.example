# ============================================================
# VARIABLES DE ENTORNO — PROD (plantilla)
# 1. Copiar este archivo: cp .env.prod.example .env.prod
# 2. Completar todos los valores
# 3. .env.prod esta en .gitignore — nunca commitear
# ============================================================

# --- Postgres ---
POSTGRES_DB=altoro_db
POSTGRES_USER=altoro_prod
POSTGRES_PASSWORD=<contrasena-fuerte-minimo-20-caracteres>

# --- RabbitMQ (NO usar guest en prod) ---
RABBITMQ_USERNAME=altoro_rabbit
RABBITMQ_PASSWORD=<contrasena-fuerte-minimo-20-caracteres>

# --- JWT (minimo 32 caracteres aleatorios) ---
# Generar con: openssl rand -base64 48
JWT_SECRET=<secret-aleatorio-minimo-32-caracteres>
JWT_EXPIRATION=86400000

# --- Correo real ---
MAIL_HOST=smtp.tuproveedor.com
MAIL_PORT=587
MAIL_USERNAME=notificaciones@tudominio.com
MAIL_PASSWORD=<contrasena-de-aplicacion>
