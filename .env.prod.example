# ============================================================
# VARIABLES DE ENTORNO — PROD (plantilla)
# 1. Copiar este archivo: cp .env.prod.example .env.prod
# 2. Completar todos los valores
# 3. .env.prod esta en .gitignore — nunca commitear
# ============================================================

# --- Postgres ---
POSTGRES_DB=altoro_db
POSTGRES_USER=altoro_prod
POSTGRES_PASSWORD=<contrasena-fuerte-minimo-20-caracteres>

# --- RabbitMQ (NO usar guest en prod) ---
RABBITMQ_USERNAME=altoro_rabbit
RABBITMQ_PASSWORD=<contrasena-fuerte-minimo-20-caracteres>

# --- JWT (minimo 32 caracteres aleatorios) ---
# Generar con: openssl rand -base64 48
JWT_SECRET=<secret-aleatorio-minimo-32-caracteres>
# Expiración del access token en milisegundos (por defecto 30 min = 1800000)
JWT_EXPIRATION=1800000

# --- Correo real ---
MAIL_HOST=smtp.tuproveedor.com
MAIL_PORT=587
MAIL_USERNAME=notificaciones@tudominio.com
MAIL_PASSWORD=<contrasena-de-aplicacion>

# --- CORS (dominio real del frontend; sin barra final) ---
# Varios orígenes separados por coma: https://altoro.com,https://www.altoro.com
CORS_ALLOWED_ORIGINS=https://tudominio.com

# --- Admin inicial (bootstrap automático en el primer arranque de prod) ---
# Se usa solo si aún no existe ningún ADMIN activo. Cambiar la contraseña tras el primer login.
BOOTSTRAP_ADMIN_EMAIL=admin@tudominio.com
BOOTSTRAP_ADMIN_PASSWORD=<contrasena-fuerte-inicial>

# --- Reverse proxy ---
# Local/pruebas: ":80"  |  Producción: tu dominio (ej. altoro.tudominio.com)
SITE_ADDRESS=:80
